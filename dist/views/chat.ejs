<!DOCTYPE html>
<html lang="uk">

<head>
  <meta charset="UTF-8" />
  <title>Служба підтримки</title>
  <style>
    /* Стілі залишаються твої */
    * {
      box-sizing: border-box;
    }

    body,
    html {
      margin: 0;
      padding: 0;
      height: 100%;
      font-family: Arial, sans-serif;
      background-color: #f0f2f5;
      display: flex;
      justify-content: center;
      align-items: center;
    }

    .chat-container {
      width: 420px;
      height: 650px;
      display: flex;
      flex-direction: column;
      padding: 15px;
      border-radius: 16px;
      background: #fff;
      box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    }

    .chat-header {
      text-align: center;
      font-size: 18px;
      font-weight: bold;
      color: #4CAF50;
      margin-bottom: 10px;
    }

    .messages {
      flex: 1;
      padding: 10px;
      border: 1px solid #ddd;
      border-radius: 12px;
      background: #fafafa;
      overflow-y: auto;
      margin-bottom: 15px;
      display: flex;
      flex-direction: column;
    }

    .message {
      margin: 8px 0;
      padding: 10px 14px;
      border-radius: 14px;
      max-width: 75%;
      font-size: 14px;
      line-height: 1.4;
      position: relative;
    }

    .client-msg {
      background: #6a82fb;
      color: white;
      align-self: flex-end;
      border-bottom-right-radius: 4px;
    }

    .operator-msg {
      background: #4CAF50;
      color: white;
      align-self: flex-start;
      border-bottom-left-radius: 4px;
    }

    .meta {
      font-size: 11px;
      opacity: 0.7;
      margin-top: 3px;
      text-align: right;
    }

    .input-box {
      display: flex;
      border-top: 1px solid #ddd;
    }

    .input-box input {
      flex: 1;
      padding: 12px;
      border: none;
      border-radius: 10px 0 0 10px;
      outline: none;
      background: #f0f0f0;
      font-size: 14px;
    }

    .input-box button {
      background: #4CAF50;
      border: none;
      padding: 0 20px;
      color: white;
      font-size: 16px;
      font-weight: 600;
      border-radius: 0 10px 10px 0;
      cursor: pointer;
      transition: background 0.3s ease;
    }

    .input-box button:hover {
      background: #45a049;
    }
  </style>
</head>

<body>
  <div class="chat-container">
    <div class="chat-header">Чат підтримки (<%= username %>)</div>
    <div class="messages" id="messages"></div>
    <div class="input-box">
      <input id="msgInput" type="text" placeholder="Напишіть повідомлення..." />
      <button onclick="sendMessage()">➤</button>
    </div>
  </div>

  <script src="/socket.io/socket.io.js"></script>
  <script>

    const USERNAME = "<%= username %>";

    const socket = io();
    const messages = document.getElementById("messages");
    const msgInput = document.getElementById("msgInput");

    socket.on("connect", () => {
      // ✅ Реєструємо клієнта одразу після зʼєднання
      socket.emit("register_client", { id: socket.id, username: USERNAME });
    });

    // Відправка повідомлення клієнтом
    function sendMessage() {
      const text = msgInput.value.trim();
      if (!text) return;
      socket.emit('client_message', { text, username: USERNAME, id: socket.id });
      addMessage(USERNAME, text, 'client-msg');
      msgInput.value = '';
    }

    // Отримання повідомлення від оператора
    socket.on('client_receive', ({ text, username }) => {
      addMessage(username || "Оператор", text, 'operator-msg');
    });

    // Додавання повідомлення в UI
    function addMessage(user, text, type) {
      const div = document.createElement("div");
      div.classList.add("message", type);
      div.innerHTML = `<strong>${user}</strong><br>${text}<div class="meta">${new Date().toLocaleTimeString()}</div>`;
      messages.appendChild(div);
      messages.scrollTop = messages.scrollHeight;
    }

    // Відправка на Enter
    msgInput.addEventListener("keypress", (e) => {
      if (e.key === "Enter") sendMessage();
    });
  </script>
</body>

</html>